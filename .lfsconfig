[lfs]
	url = https://huggingface.co/sunnypilot/sunnypilot-lfs.git/info/lfs
	pushurl = https://huggingface.co/sunnypilot/sunnypilot-lfs.git/info/lfs

	locksverify = false
	# big_driving_tinygrad.pkl (~780 MB) is the precompiled eGPU (chestnut) model,
	# never used on a comma device without one. Skip it by default so device installs
	# don't stall on the download; fetch it explicitly when needed with:
	#   git lfs pull --include="openpilot/selfdrive/modeld/models/big_driving_tinygrad.pkl"
	fetchexclude = openpilot/selfdrive/modeld/models/big_driving_tinygrad.pkl
